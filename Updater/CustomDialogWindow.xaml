<Window x:Class="Updater.CustomDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog" Height="260" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#222" WindowStyle="None">
    <Border CornerRadius="12" BorderBrush="#FFD700" BorderThickness="2" Background="#222">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleBlock" 
                       FontFamily="pack://application:,,,/Updater;component/Resources/Fonts/#ITC Benguiat Std Book"
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#FFD700" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       TextAlignment="Center"/>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="MessageBlock" 
                           FontFamily="pack://application:,,,/Updater;component/Resources/Fonts/#ITC Benguiat Std Book"
                           FontSize="16" 
                           FontWeight="Bold"
                           Foreground="#FFD700" 
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SecondaryBlock" 
                           FontFamily="pack://application:,,,/Updater;component/Resources/Fonts/#ITC Benguiat Std Book"
                           FontSize="15" 
                           FontWeight="Bold"
                           Foreground="#FFD700" 
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="HyperlinkBlock" FontSize="15" Margin="0,8,0,0" Visibility="Collapsed"
                           FontFamily="pack://application:,,,/Updater;component/Resources/Fonts/#ITC Benguiat Std Book"
                           FontWeight="Bold">
                    <Hyperlink x:Name="DialogHyperlink" RequestNavigate="DialogHyperlink_RequestNavigate"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="OK" Width="90" Margin="0,0,10,0" Click="OkButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontFamily" Value="pack://application:,,,/Updater;component/Resources/Fonts/#ITC Benguiat Std Book"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Background" Value="#FFD700"/>
                            <Setter Property="Foreground" Value="#4B0082"/>
                            <Setter Property="BorderBrush" Value="#FFD700"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF8E36B"/>
                                                <Setter Property="Foreground" Value="#B9000000"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#FFB8860B"/>
                                                <Setter Property="Foreground" Value="#FFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Click="CancelButton_Click" Visibility="Collapsed">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="FontFamily" Value="pack://application:,,,/Updater;component/Resources/Fonts/#ITC Benguiat Std Book"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="18"/>
                            <Setter Property="Background" Value="#FFD700"/>
                            <Setter Property="Foreground" Value="#4B0082"/>
                            <Setter Property="BorderBrush" Value="#FFD700"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFF8E36B"/>
                                                <Setter Property="Foreground" Value="#B9000000"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#FFB8860B"/>
                                                <Setter Property="Foreground" Value="#FFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
