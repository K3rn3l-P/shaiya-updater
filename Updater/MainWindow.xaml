<Window x:Name="_window1" x:Class="Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Updater"
        mc:Ignorable="d"
                Title="Shaiya Updater" Height="689" Width="1060" ResizeMode="NoResize" WindowStyle="None"
        MouseLeftButtonDown="Window1_MouseLeftButtonDown" WindowStartupLocation="CenterScreen" Initialized="Window1_Initialized" Loaded="Window1_Loaded" Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <!-- Stile globale per TextBox -->
        <Style TargetType="TextBox">
            <!-- FontFamily rimosso: usa quello globale da App.xaml -->
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <!-- Stile globale per ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Stile moderno gold per i bottoni principali -->
        <Style x:Key="GoldMainButton" TargetType="Button">
            <!-- FontFamily rimosso: usa quello globale da App.xaml -->
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B9000000" Offset="0.0" />
                        <GradientStop Color="#FFD700" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#FFD700" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="18,2,18,2" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B9000000" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF8E36B"/>
                                <Setter Property="Foreground" Value="#B9000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFB8860B"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="_grid1" Height="689" Background="#00000000" HorizontalAlignment="Center" Width="1060">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="362*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="160*"/>
            <RowDefinition Height="67*"/>
        </Grid.RowDefinitions>
        <ProgressBar x:Name="_progressBar2" Margin="126,114,0,0" Width="566" HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" Grid.Row="2" Grid.Column="1" Value="100">
            <ProgressBar.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFEB2D38" Offset="1"/>
                </LinearGradientBrush>
            </ProgressBar.Foreground>
        </ProgressBar>
        <ProgressBar x:Name="_progressBar1" Margin="126,77,0,0" Width="566" HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" Grid.Row="2" Grid.Column="1" Value="100">
            <ProgressBar.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFF5F026" Offset="1"/>
                </LinearGradientBrush>
            </ProgressBar.Foreground>
        </ProgressBar>
        <TextBox x:Name="_textBox1" TextWrapping="Wrap" FontFamily="Algerian" Margin="126,90,0,0" RenderTransformOrigin="0.515,0.389" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Width="566" Grid.Row="2" Grid.Column="1" ClipToBounds="True" SelectionOpacity="0"/>
        <TextBox x:Name="_textBoxSpeed" TextWrapping="Wrap" FontFamily="Algerian" Margin="457,57,0,0" RenderTransformOrigin="0.515,0.389" Height="19" HorizontalAlignment="Left" VerticalAlignment="Top" Width="235" Grid.Row="2" Grid.Column="1" ClipToBounds="True" SelectionOpacity="0"/>

        <WebBrowser x:Name="_webBrowser1" Margin="10,26,27,0" Height="5" Focusable="False" VerticalAlignment="Top" Panel.ZIndex="1" RenderTransformOrigin="0.5,0.5">
            <WebBrowser.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1" ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </WebBrowser.RenderTransform>
        </WebBrowser>
        <Button x:Name="_button1" Content="" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,4,6,0" Click="Button1_Click" BorderThickness="0,0,0,0" MouseEnter="Button1_MouseEnter" MouseLeave="Button1_MouseLeave" ClickMode="Press" PreviewMouseLeftButtonUp="Button1_PreviewMouseLeftButtonUp" Grid.Column="1" BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{x:Null}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Width="30" Height="30"/>
        <Button x:Name="_button2" Content="" Margin="703,58,0,0" RenderTransformOrigin="0.506,1.074" Height="70" HorizontalAlignment="Left" Width="270" Click="Button2_Click" MouseEnter="Button2_MouseEnter" MouseLeave="Button2_MouseLeave" PreviewMouseLeftButtonUp="Button2_PreviewMouseLeftButtonUp" ClickMode="Press" Grid.Row="2" Grid.Column="1" BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{x:Null}" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" VerticalAlignment="Top"/>
        <Button x:Name="ButtonWebsite" Click="ButtonWebsite_Click" 
        Width="66" Height="89" BorderBrush="Transparent"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,85,0,0" Grid.RowSpan="2" Grid.Column="1" Foreground="#00000000" Background="#00000000" OpacityMask="#00000000" />
        <Button x:Name="ButtonDiscord" Click="ButtonDiscord_Click" 
        Width="66" Height="89" Background="Transparent" BorderBrush="Transparent"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,105,0,0" Grid.Row="1" Grid.Column="1" Foreground="#00000000" OpacityMask="#00000000" />
        <Button x:Name="ButtonItemmall" Click="ButtonItemmall_Click" 
        Width="66" Height="89" Background="Transparent" BorderBrush="Transparent"
        HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Margin="0,248,0,0" Grid.Column="1" Foreground="#00000000" OpacityMask="#00000000" />
        <Button x:Name="ButtonRanks" Click="ButtonRanks_Click" 
        Width="66" Height="89" Background="Transparent" BorderBrush="Transparent"
        HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Margin="0,387,0,0" Grid.Column="1" Grid.RowSpan="2" Foreground="#00000000" OpacityMask="#00000000" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,5,0,84" Grid.ColumnSpan="2">
            <Button x:Name="_buttonRestore" Content="RESTORE UPDATER" Height="27" Width="205"
            Click="ButtonRestore_Click" Style="{StaticResource GoldMainButton}" Margin="0,0,18,0"/>
            <Button x:Name="_buttonGraphicsSetting" Content="GRAPHICS SETTINGS" Height="27" Width="205"
            Click="ButtonGraphicsSetting_Click" Style="{StaticResource GoldMainButton}"/>
        </StackPanel>
    </Grid>
</Window>
