<Window x:Class="Updater.GraphicsSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRAPHICS SETTINGS"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- ComboBox ToggleButton Template (modern gold/black) -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" BorderBrush="#FFD700" BorderThickness="2" Background="#B9000000" CornerRadius="6">
                <Grid>
                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FFD700" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Width="12" Height="8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#FF2D2D2D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#FFB8860B"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#FFD700"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#B9000000"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox Style with dark dropdown and gold highlight -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Background" Value="#B9000000"/>
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6,2,24,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                Template="{StaticResource ComboBoxToggleButton}"
                                Grid.Column="2"
                                Focusable="false"
                                IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                Margin="6,2,24,2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
                            <Popup Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                    SnapsToDevicePixels="True"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="300"
                                    Background="#B9000000"
                                    >
                                    <Border x:Name="DropDownBorder" BorderBrush="#FFD700" BorderThickness="2" Background="#B9000000" CornerRadius="6"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Background" Value="#B9000000"/>
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="6,2,6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#FFD700" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF2D2D2D"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Centered CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border CornerRadius="4" BorderBrush="#FFD700" BorderThickness="2" Background="#B9000000" />
                                <Path x:Name="CheckMark" Visibility="Collapsed" Stroke="#FFD700" StrokeThickness="3" Data="M4,10 L9,15 L16,5" StrokeEndLineCap="Round" StrokeStartLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Style for Sliders -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Background" Value="#B9000000"/>
            <Setter Property="Height" Value="24"/>
        </Style>
        <!-- Style for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Background" Value="#B9000000"/>
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Style for TabControl and TabItem -->
        <Style TargetType="TabControl">
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#B9000000"/>
            <Setter Property="Foreground" Value="#FFD700"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#B9000000"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- Style for Buttons (modern gold theme) -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#4B0082"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF8E36B"/>
                                <Setter Property="Foreground" Value="#B9000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFB8860B"/>
                                <Setter Property="Foreground" Value="#FFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Modern gold title style -->
        <Style x:Key="GoldTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Algerian"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B9000000" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ScrollBar Style for gold/black theme -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="#B9000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Focusable="false">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Style="{x:Null}" Height="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Height="40" Margin="2" Background="#FFD700" BorderBrush="#B9000000" BorderThickness="1">
                                        <Thumb.Effect>
                                            <DropShadowEffect Color="#B9000000" BlurRadius="4" ShadowDepth="1"/>
                                        </Thumb.Effect>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Style="{x:Null}" Height="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ScrollViewer Style to use custom ScrollBar -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Column="1" Grid.Row="0"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Column="0" Grid.Row="1"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Height="8"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Background image for launcher style -->
        <Image Source="pack://application:,,,/Updater;component/Resources/Bitmap/Bitmap167.bmp" Stretch="Fill" Opacity="0.95" Panel.ZIndex="0"/>
        <Border CornerRadius="18" BorderBrush="#FFD700" BorderThickness="3" Padding="10" Background="#B9000000" Panel.ZIndex="1">
            <Grid>
                <TextBlock Text="" Style="{StaticResource GoldTitle}" Grid.Row="0" Grid.ColumnSpan="2"/>
                <TabControl Margin="10" Grid.Row="1">
                    <!-- Video Settings Tab -->
                    <TabItem Header="Video" Height="28" Margin="-2,-2,-2,0" VerticalAlignment="Top">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Resolution:" Foreground="#FFD700" Margin="0,0,0,5" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <ComboBox x:Name="ResolutionComboBox" Margin="0,0,0,10">
                                    <ComboBoxItem Content="[INTERFACE_800X600]" />
                                    <ComboBoxItem Content="[INTERFACE_1024X768]" />
                                    <ComboBoxItem Content="[INTERFACE_1280X720]" />
                                    <ComboBoxItem Content="[INTERFACE_1280X800]" />
                                    <ComboBoxItem Content="[INTERFACE_1280X1024]" />
                                    <ComboBoxItem Content="[INTERFACE_1280X960]" />
                                    <ComboBoxItem Content="[INTERFACE_1360X768]" />
                                    <ComboBoxItem Content="[INTERFACE_1600X900]" />
                                    <ComboBoxItem Content="[INTERFACE_1600X1024]" />
                                    <ComboBoxItem Content="[INTERFACE_1680X1050]" />
                                    <ComboBoxItem Content="[INTERFACE_1600X1200]" />
                                    <ComboBoxItem Content="[INTERFACE_1920X1080]" />
                                    <ComboBoxItem Content="[INTERFACE_1920X1200]" />
                                </ComboBox>
                                <CheckBox x:Name="FullscreenCheckBox" Content="Fullscreen" Margin="0,0,0,5" />
                                <CheckBox x:Name="WaterCheckBox" Content="Water Effects" Margin="0,0,0,5" />
                                <CheckBox x:Name="ShadowCheckBox" Content="Shadows" Margin="0,0,0,5" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Glow Level:" Grid.Column="0" Foreground="#FFD700" VerticalAlignment="Center" />
                                    <Slider x:Name="GlowLevelSlider" Grid.Column="2" Minimum="0" Maximum="4" Value="1"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Width="200" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gamma (Brightness):" Grid.Column="0" Foreground="#FFD700" VerticalAlignment="Center" />
                                    <Slider x:Name="GammaSlider" Grid.Column="2" Minimum="0" Maximum="4" Value="1"
                                            TickFrequency="1" IsSnapToTickEnabled="True" Width="200" />
                                </Grid>
                                <TextBlock Text="Texture Quality:" Foreground="#FFD700" Margin="0,10,0,5" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <ComboBox x:Name="TextureComboBox" SelectedIndex="2" Margin="0,0,0,10">
                                    <ComboBoxItem Content="LOW" />
                                    <ComboBoxItem Content="MEDIUM" />
                                    <ComboBoxItem Content="HIGH" />
                                </ComboBox>
                                <TextBlock Text="Render Distance:" Foreground="#FFD700" Margin="0,10,0,5" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <ComboBox x:Name="RangeComboBox" SelectedIndex="2" Margin="0,0,0,10">
                                    <ComboBoxItem Content="LOW" />
                                    <ComboBoxItem Content="MEDIUM" />
                                    <ComboBoxItem Content="HIGH" />
                                </ComboBox>
                                <CheckBox x:Name="HelmetCheckBox" Content="Helmet" Margin="0,10,0,5" />
                                <CheckBox x:Name="CloakCheckBox" Content="Mantle" Margin="0,0,0,5" />
                                <CheckBox x:Name="WeaponEffCheckBox" Content="Weapon Effects" Margin="0,0,0,10" />
                                <TextBlock Text="QUICK PRESETS:" Foreground="#FFD700" Margin="0,10,0,5" FontFamily="Algerian" FontWeight="Bold" FontSize="18"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="LOW" Click="SetLowSettings_Click" Width="120" Background="#B9000000" Foreground="#FFD700" BorderBrush="#FFD700" />
                                    <Button Content="MEDIUM" Click="SetMidSettings_Click" Width="120" Background="#B9000000" Foreground="#FFD700" BorderBrush="#FFD700" />
                                    <Button Content="HIGH" Click="SetHighSettings_Click" Width="120" Background="#B9000000" Foreground="#FFD700" BorderBrush="#FFD700" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Login Tab -->
                    <TabItem Header="Login">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Login ID:" Foreground="#FFD700" Margin="0,0,0,5" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <TextBox x:Name="LoginIDTextBox" Width="200" />
                                <CheckBox x:Name="SaveLoginCheckBox" Content="Save Login ID" Margin="0,10,0,5" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Interface Tab -->
                    <TabItem Header="Interface">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="SkillWndLockCheckBox" Content="Lock Skills in Slots" Margin="0,0,0,5" />
                                <TextBlock Text="Prevents accidental skill movement (on the skill bar)" FontSize="10" Foreground="Gray" Margin="0,0,0,10" />
                                <CheckBox x:Name="ShowMessageNoticeCheckBox" Content="Show Message Notices" />
                                <CheckBox x:Name="ChatBoxViewCheckBox" Content="Enable Chat Box View" />
                                <CheckBox x:Name="MapboardSizeCheckBox" Content="Enable Mapboard Resize" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Sound Tab -->
                    <TabItem Header="Sound">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Background Music Volume" Foreground="#FFD700" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <Slider x:Name="BGMVolumeSlider" Minimum="0" Maximum="6" Value="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Width="200" Margin="0,5,0,10" />
                                <TextBlock Text="Effects Volume" Foreground="#FFD700" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <Slider x:Name="EffectsVolumeSlider" Minimum="0" Maximum="6" Value="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Width="200" Margin="0,5,0,10" />
                                <TextBlock Text="World Volume" Foreground="#FFD700" FontFamily="Algerian" FontWeight="Bold" FontSize="16"/>
                                <Slider x:Name="WorldVolumeSlider" Minimum="0" Maximum="6" Value="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Width="200" Margin="0,5,0,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- User Tab -->
                    <TabItem Header="User">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="UseMouseCheckBox" Content="Enable Mouse Control" />
                                <CheckBox x:Name="InvertMouseCheckBox" Content="Invert Mouse" />
                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mouse Sensitivity:" Foreground="#FFD700" Margin="0,1,0,5" Grid.Column="0" VerticalAlignment="Center" />
                                    <Slider x:Name="MouseSensitivitySlider" Minimum="1" Maximum="10" Value="3" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Width="200" Grid.Column="2" />
                                </Grid>
                                <CheckBox x:Name="ShowUserNameCheckBox" Content="Show User Names" Margin="0,10,0,5" />
                                <CheckBox x:Name="RejectFightCheckBox" Content="Reject Fight Requests" Margin="0,1,0,5" />
                                <CheckBox x:Name="RejectTradeCheckBox" Content="Reject Trade Requests" Margin="0,0,0,5" />
                                <CheckBox x:Name="RejectPartyCheckBox" Content="Reject Party Invitations" Margin="0,0,0,5" />
                                <CheckBox x:Name="UseFilterCheckBox" Content="Enable Chat Filter" Margin="0,10,0,5" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- Advanced Tab -->
                    <TabItem Header="Advanced">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="PetsCheckBox" Content="Show Pets (/pets on/off)" Margin="0,0,0,5" />
                                <CheckBox x:Name="WingsCheckBox" Content="Show Wings (/wings on/off)" Margin="0,0,0,5" />
                                <CheckBox x:Name="CostumesCheckBox" Content="Show Costumes (/costumes on/off)" Margin="0,0,0,5" />
                                <CheckBox x:Name="EffectsCheckBox" Content="Enable Effects (/effects on/off)" Margin="0,0,0,5" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <!-- Button Panel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                    <Button Content="CANCEL" Click="CancelButton_Click" Width="120"/>
                    <Button Content="SAVE" Click="SaveButton_Click" Width="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
