<Window x:Class="Updater.Tool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Foreground="{DynamicResource ForegroundLightBrush}" Height="277" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BackgroundDarkBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Selezione:" FontWeight="Bold" FontSize="22" Margin="0,0,0,12" Foreground="{DynamicResource ForegroundLightBrush}" Style="{StaticResource ModernTextBlock}"/>
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,0">
            <TextBlock Text="Cartella patch:" FontWeight="Bold" Foreground="{DynamicResource ForegroundLightBrush}" Style="{StaticResource ModernTextBlock}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="PatchDirTextBox" Width="320" IsReadOnly="True" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"/>
                <Button Content="Cambia..." Width="90" Click="ChangePatchDir_Click" Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Click="OkButton_Click" Margin="8,0,0,0" Style="{StaticResource ModernButton}"/>
            <Button Content="Annulla" Width="90" IsCancel="True" Margin="8,0,0,0" Style="{StaticResource ModernButton}"/>
        </StackPanel>
    </Grid>
</Window>
